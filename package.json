    "@fontsource/michroma": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
