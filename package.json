{
  "name": "midnight-frequency",
  "private": true,
  "version": "1.0.0",
  "description": "MIDNIGHT FREQUENCY — an unofficial, fan-made Persona 3 inspired music experience.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
